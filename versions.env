# Versions installed by install.sh.
# Empty = newest official release (default branch).
# BEST PRACTICE: after the first successful test on your real printer,
# write down the exact versions (git commit/tag) here so every customer
# gets exactly the version you tested.  Example: KLIPPER_REF=v0.13.0
KLIPPER_REPO=https://github.com/Klipper3d/klipper.git
KLIPPER_REF=
MOONRAKER_REPO=https://github.com/Arksine/moonraker.git
MOONRAKER_REF=
MAINSAIL_CONFIG_REPO=https://github.com/mainsail-crew/mainsail-config.git
MAINSAIL_CONFIG_REF=
# Mainsail web UI release: "latest" or a tag such as v2.14.0
MAINSAIL_VERSION=latest
